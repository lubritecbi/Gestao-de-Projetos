# Proxy reverso com HTTPS para a Gestão de Projetos.
# Ajuste server_name e certificados (da CA interna da empresa ou Let's Encrypt).
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;

server {
    listen 80;
    server_name projetos.empresa.local;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name projetos.empresa.local;

    ssl_certificate     /etc/ssl/empresa/projetos.crt;
    ssl_certificate_key /etc/ssl/empresa/projetos.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    client_max_body_size 1m;
    server_tokens off;

    # Opcional: restringir à rede interna/VPN
    # allow 10.0.0.0/8;
    # allow 192.168.0.0/16;
    # deny all;

    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params_gestao;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params_gestao;
    }
}

# Conteúdo de /etc/nginx/proxy_params_gestao:
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $remote_addr;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_http_version 1.1;
#   proxy_read_timeout 30s;
