# Copie para .env e ajuste. NUNCA versione o arquivo .env.
NODE_ENV=production
PORT=3000
# Em produção, ouça só localmente e publique via proxy reverso com HTTPS (Nginx/IIS/Traefik).
HOST=127.0.0.1
# Nº de proxies à frente da aplicação (1 = um Nginx). Necessário para registrar o IP real e limitar tentativas por IP.
TRUST_PROXY=1
DB_PATH=./data/gestao.db
TZ=America/Sao_Paulo

# Sessão
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=10

# Senhas e bloqueio
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_AGE_DAYS=0
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Retenção da trilha de auditoria (dias)
AUDIT_RETENTION_DAYS=365

# Só em desenvolvimento sem HTTPS (em produção é sempre true)
COOKIE_SECURE=false
